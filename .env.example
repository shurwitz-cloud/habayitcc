# Copy to .env.local and fill in values. Never commit real secrets.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (https://dashboard.stripe.com)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Zeffy (fee-free Chai Partner option — https://www.zeffy.com)
# Public form URL from Zeffy Share (recurring membership / monthly donation)
NEXT_PUBLIC_ZEFFY_CHAI_PARTNER_URL=
# API key from Zeffy Settings → Integrations (optional — verifies webhook payments)
ZEFFY_API_KEY=
# Optional: only treat payments from this campaign id as Chai Partners
ZEFFY_CHAI_CAMPAIGN_ID=
# Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@habayitcc.org
# Where admin copies go (contact/RSVP/donation alerts). Can be a personal Gmail temporarily.
ADMIN_NOTIFICATION_EMAIL=info@habayitcc.org

# Admin CRM login (single shared password — use a strong random value)
ADMIN_EMAIL=info@habayitcc.org
ADMIN_SECRET=

# Volunteer CRM access (no donations / Chai / payments / photos / registrations)
# Comma-separated emails that share VOLUNTEER_SECRET
VOLUNTEER_EMAILS=volunteer@habayitcc.org
VOLUNTEER_SECRET=

# Receipt URL signing (optional — falls back to ADMIN_SECRET if unset)
RECEIPT_SIGNING_SECRET=

# Google Sheets export (optional — service account JSON fields)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_CONTACT_ID=
GOOGLE_SHEETS_DONATIONS_ID=
GOOGLE_SHEETS_CHAI_PARTNERS_ID=
GOOGLE_SHEETS_HEBREW_SCHOOL_ID=
GOOGLE_SHEETS_ACHIM_ID=
GOOGLE_SHEETS_BMX_ID=
GOOGLE_SHEETS_BLOOM_ID=
