# =============================================================================
# HaBayit — environment variables (copy to .env.local for local development)
# Never commit real secrets. Set production values in Vercel → Project → Settings → Environment Variables.
# =============================================================================

# --- Public (safe in browser) ---
NEXT_PUBLIC_SITE_URL=https://www.habayitcc.org
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: outbound Chai Partner checkout on Zeffy (no data sent back to HaBayit)
NEXT_PUBLIC_ZEFFY_CHAI_PARTNER_URL=
# Optional: enable admin Zeffy reconcile UI (requires ZEFFY_API_KEY server-side)
NEXT_PUBLIC_ZEFFY_RECONCILE_ENABLED=false

# --- Supabase (server) ---
# Required for CRM writes. Without this, public forms cannot persist data.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (server) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: only if a Stripe test-mode webhook points at production URL
STRIPE_WEBHOOK_SECRET_TEST=

# --- Admin auth ---
ADMIN_EMAIL=info@habayitcc.org
ADMIN_SECRET=
VOLUNTEER_EMAILS=
VOLUNTEER_SECRET=

# --- Receipt URLs (recommended separate from ADMIN_SECRET in production) ---
RECEIPT_SIGNING_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@habayitcc.org
ADMIN_NOTIFICATION_EMAIL=info@habayitcc.org
# Optional: override admin alert sender (default notifications@habayitcc.org — not info@)
# ADMIN_NOTIFICATION_FROM=notifications@habayitcc.org

# --- Google Sheets backup (optional) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_CONTACT_ID=
GOOGLE_SHEETS_DONATIONS_ID=
GOOGLE_SHEETS_CHAI_PARTNERS_ID=
GOOGLE_SHEETS_HEBREW_SCHOOL_ID=
GOOGLE_SHEETS_ACHIM_ID=
GOOGLE_SHEETS_BMX_ID=
GOOGLE_SHEETS_BLOOM_ID=
GOOGLE_SHEETS_IMPORTANT_DATES_ID=
GOOGLE_SHEETS_ROSH_HASHANA_DINNER_ID=
GOOGLE_SHEETS_ROSH_HASHANA_FAIR_ID=
GOOGLE_SHEETS_PRE_RH_WOMENS_ID=

# --- Zeffy API (optional; inbound webhook sync is disabled in code) ---
ZEFFY_API_KEY=
ZEFFY_CHAI_CAMPAIGN_ID=
